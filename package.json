{
  "name": "h3-valibot",
  "type": "module",
  "version": "0.0.9",
  "description": "🤖 Schema validation for h3 using Valibot",
  "author": "Conner Bachmann <github@conner-bachmann.de>",
  "license": "MIT",
  "keywords": [
    "h3",
    "valibot",
    "validation"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./helpers": {
      "types": "./dist/helpers.d.mts",
      "default": "./dist/helpers.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.mts",
      "default": "./dist/nuxt.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "pnpm test && pnpm build && changelogen --patch && git push --follow-tags && pnpm publish",
    "test": "pnpm lint && pnpm test:types && vitest --run",
    "test:types": "tsc --noEmit --skipLibCheck"
  },
  "peerDependencies": {
    "@nuxt/kit": ">=4",
    "@nuxt/schema": ">=4",
    "valibot": ">=1"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    }
  },
  "dependencies": {
    "confbox": "^0.2.2",
    "h3": "^1.15.4",
    "valibot": "^1.2.0"
  },
  "optionalDependencies": {
    "@nuxt/kit": "^4.2.1",
    "@nuxt/schema": "^4.2.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "6.2.0",
    "@types/node": "^24.10.1",
    "@types/serve-handler": "6.1.4",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.1",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vite": "7.2.4",
    "vitest": "^4.0.14"
  }
}
